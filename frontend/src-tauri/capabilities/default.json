{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Allow the app to run the bundled backend sidecar.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-execute",
      "allow": [
        {
          "name": "binaries/backend",
          "sidecar": true,
          "args": ["--host", { "validator": "\\S+" }, "--port", { "validator": "\\d+" }]
        }
      ]
    }
  ]
}
