---
import Icon from "./Icon.astro";
import { site, issuesUrl } from "../config";
---

{
  site.showBetaBar && (
    <div class="betabar">
      <span class="beta-pill">BETA</span>
      Sirina is in public beta — expect rough edges, and tell us about them.
      <a href={issuesUrl}>Report an issue →</a>
    </div>
  )
}

<nav class="nav wrap" aria-label="Main">
  <a href="#top" class="brand">
    <img src="/logo.svg" alt="" width="34" height="34" />
    <span>Sirina</span>
  </a>
  <div class="links">
    <a href="#demo">Demo</a>
    <a href="#local">Privacy</a>
    <a href="#features">Features</a>
    <a href="#who">Who it's for</a>
    <a href="#source">Source</a>
  </div>
  <div class="actions">
    <a href={site.coffeeUrl} class="btn btn--coffee small"><Icon name="coffee" />Buy me a coffee</a>
    <a href={site.githubUrl} class="btn small gh"><Icon name="github" />GitHub</a>
  </div>
</nav>

<style>
  .betabar {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    flex-wrap: wrap;
    padding: 9px 20px;
    background: #1f1b15;
    border-bottom: 1px solid var(--line);
    font-size: 13px;
    color: var(--muted);
    text-align: center;
  }
  .betabar a { font-weight: 600; }
  .nav {
    padding-top: 18px;
    padding-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 14px 24px;
    flex-wrap: wrap;
  }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); margin-right: auto; }
  .brand img { display: block; }
  .brand span { font-family: var(--serif); font-size: 22px; font-weight: 600; letter-spacing: -0.01em; }
  .links { display: flex; align-items: center; gap: 6px 22px; font-size: 14px; flex-wrap: wrap; }
  .links a { color: var(--muted); }
  .links a:hover { color: var(--ink); }
  .actions { display: flex; gap: 10px; }
  .small { height: 38px; padding: 0 14px; border-radius: 10px; font-size: 13.5px; gap: 8px; }
  .gh { border: 1px solid var(--line-2); background: var(--surface); color: var(--ink); }
  .gh:hover { border-color: var(--line-4); color: var(--ink); }
  @media (max-width: 820px) {
    .links { display: none; }
  }
  @media (max-width: 420px) {
    .brand span { display: none; }
  }
</style>
