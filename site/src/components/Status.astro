---
import { site } from "../config";

const rows = [
  { name: "Recording & transcription", state: "stable", tone: "ok" },
  { name: "Summaries, Ask, templates", state: "stable", tone: "ok" },
  { name: "System audio capture", state: "native", tone: "ok" },
  { name: "Speaker splitting", state: "beta", tone: "warn" },
  { name: "Live captions", state: "macOS 26+", tone: "warn" },
  ...(site.hasRelease ? [] : [{ name: "Signed download (.dmg)", state: "build from source", tone: "warn" }]),
  { name: "Windows & Linux builds", state: "planned", tone: "todo" },
];
---

<section id="beta" class="wrap status">
  <div>
    <div class="beta-pill big">PUBLIC BETA</div>
    <h2>Early, honest, and getting better every release.</h2>
    <p>Core recording and transcription are solid for daily use. Some parts are still moving — here's where things stand.</p>
  </div>
  <ul class="table">
    {
      rows.map((r) => (
        <li>
          <span class={`state-dot ${r.tone}`} />
          <span class={r.tone === "todo" ? "name todo" : "name"}>{r.name}</span>
          <span class={`state ${r.tone}`}>{r.state}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .status { padding-top: 104px; padding-bottom: 40px; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 48px; align-items: start; }
  .big { font-size: 11.5px; padding: 3px 10px; letter-spacing: 0.08em; margin-bottom: 18px; }
  h2 { font-family: var(--serif); font-weight: 500; font-size: clamp(30px, 3.6vw, 44px); line-height: 1.08; letter-spacing: -0.02em; margin: 0 0 16px; text-wrap: balance; }
  p { font-size: 15.5px; line-height: 1.65; color: var(--muted-2); margin: 0; max-width: 460px; }
  .table { list-style: none; margin: 0; padding: 0; border: 1px solid var(--line); border-radius: 16px; background: var(--surface); }
  .table li { display: flex; align-items: center; gap: 14px; padding: 16px 20px; border-bottom: 1px solid #2a251e; }
  .table li:last-child { border-bottom: none; }
  .state-dot { width: 8px; height: 8px; border-radius: 50%; flex: none; }
  .state-dot.ok { background: var(--green); box-shadow: 0 0 0 3px rgba(74,140,95,0.16); }
  .state-dot.warn { background: #c98a2b; box-shadow: 0 0 0 3px rgba(201,138,43,0.16); }
  .state-dot.todo { border: 1.5px dashed var(--dim-3); }
  .name { flex: 1; font-size: 14.5px; font-weight: 600; }
  .name.todo { color: var(--muted); }
  .state { font-size: 12.5px; font-family: var(--mono); text-align: right; }
  .state.ok { color: var(--green-2); }
  .state.warn { color: var(--amber); }
  .state.todo { color: var(--dim); }
</style>
