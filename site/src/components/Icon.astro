---
// Small stroke/fill icons from the landing-page design, drawn on a 16×16 grid.
interface Props {
  name: keyof typeof icons;
  size?: number;
  color?: string;
  width?: number;
  class?: string;
}

const icons = {
  github: { fill: true, d: ["M8 .2a8 8 0 0 0-2.5 15.6c.4 0 .5-.2.5-.4v-1.5c-2.2.5-2.7-1-2.7-1-.4-.9-.9-1.2-.9-1.2-.7-.5.1-.5.1-.5.8.1 1.2.8 1.2.8.7 1.3 1.9.9 2.3.7.1-.5.3-.9.5-1.1-1.8-.2-3.6-.9-3.6-4 0-.9.3-1.6.8-2.1-.1-.2-.4-1 .1-2.1 0 0 .7-.2 2.2.8a7.4 7.4 0 0 1 4 0c1.5-1 2.2-.8 2.2-.8.4 1.1.2 1.9.1 2.1.5.6.8 1.3.8 2.1 0 3.1-1.9 3.7-3.6 3.9.3.3.6.8.6 1.5v2.2c0 .2.1.5.6.4A8 8 0 0 0 8 .2z"] },
  coffee: { d: ["M2.5 6h9v4a3.5 3.5 0 0 1-3.5 3.5H6A3.5 3.5 0 0 1 2.5 10z", "M11.5 7.2h1a1.8 1.8 0 0 1 0 3.6h-1.2M5 1.8v2M8 1.8v2"] },
  download: { d: ["M8 2v8M5 7l3 3 3-3M2.5 11v2.5h11V11"] },
  pointer: { d: ["M6 2.5v7.2L4.6 8.4a1.2 1.2 0 0 0-1.8 1.6L6 14h6.2l1-5.4a1.3 1.3 0 0 0-1.1-1.5L8.5 6.5V2.5a1.25 1.25 0 0 0-2.5 0z"] },
  mic: { d: ["M8 2a2 2 0 0 1 2 2v3a2 2 0 0 1-4 0V4a2 2 0 0 1 2-2z", "M4 8a4 4 0 0 0 8 0M8 12v2"] },
  clock: { d: ["M8 2a6 6 0 1 0 0 12A6 6 0 0 0 8 2z", "M8 4.5v3.5l2.3 1.4"] },
  chat: { d: ["M2.5 4.5a2 2 0 0 1 2-2h7a2 2 0 0 1 2 2v4a2 2 0 0 1-2 2H6.5L3 13V10.5a2 2 0 0 1-.5-1.3z"] },
  people: { d: ["M5.5 2.8a2.2 2.2 0 1 0 0 4.4 2.2 2.2 0 0 0 0-4.4zM11 4.2a1.8 1.8 0 1 0 0 3.6 1.8 1.8 0 0 0 0-3.6z", "M1.8 13c0-2 1.6-3.3 3.7-3.3S9.2 11 9.2 13M9.8 12.5c0-1.5 1-2.6 2.6-2.6 1.3 0 2.2.8 2.4 2"] },
  doc: { d: ["M4.5 1.5h7A1.5 1.5 0 0 1 13 3v10a1.5 1.5 0 0 1-1.5 1.5h-7A1.5 1.5 0 0 1 3 13V3a1.5 1.5 0 0 1 1.5-1.5z", "M5.5 5h5M5.5 8h5M5.5 11h3"] },
  search: { d: ["M7 2.5a4.5 4.5 0 1 0 0 9 4.5 4.5 0 0 0 0-9z", "m11 11 3 3"] },
  chevron: { d: ["m6 4 4 4-4 4"] },
  back: { d: ["m10 4-4 4 4 4"] },
  check: { d: ["m3.5 8.5 3 3 6-7"] },
  checkCircle: { d: ["M8 1.5a6.5 6.5 0 1 0 0 13 6.5 6.5 0 0 0 0-13z", "m5 8 2 2 4-4.5"] },
  warn: { d: ["M8 2 14.5 13.5h-13z", "M8 6.5v3.2M8 11.6v.1"] },
  disk: { d: ["M4 3h8a2 2 0 0 1 2 2v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2z", "M2 7h12M5 10h2"] },
  wave: { d: ["M2 8h1.5M5 5v6M7.5 3v10M10 5.5v5M12.5 7v2M14.5 8H14"] },
  sparkle: { d: ["M8 1.5 9.6 6 14 7.5 9.6 9 8 13.5 6.4 9 2 7.5 6.4 6z"] },
  tag: { d: ["M2 2.5h5.5L14 9l-5 5-6.5-6.5z", "M5.5 4.4a1.1 1.1 0 1 0 0 2.2 1.1 1.1 0 0 0 0-2.2z"] },
  captions: { d: ["M3 3h10a1.5 1.5 0 0 1 1.5 1.5v7A1.5 1.5 0 0 1 13 13H3a1.5 1.5 0 0 1-1.5-1.5v-7A1.5 1.5 0 0 1 3 3z", "M4.5 7.5h4M10 7.5h1.5M4.5 10h2M8 10h3.5"] },
  up: { d: ["M8 13V3M4 7l4-4 4 4"] },
};

const { name, size = 16, color = "currentColor", width = 1.6, class: className } = Astro.props;
const icon = icons[name] as { fill?: boolean; d: string[] };
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 16 16"
  fill={icon.fill ? color : "none"}
  stroke={icon.fill ? "none" : color}
  stroke-width={width}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {icon.d.map((d) => <path d={d} />)}
</svg>
