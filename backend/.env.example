# Transcription model. medium is the default (good quality, already downloaded).
# For best offline quality bump to large-v3-turbo (or large-v3); first use
# downloads the model (~1.5-3 GB).
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
# Force a language (e.g. en, es, de) to skip detection; empty = auto-detect.
WHISPER_LANGUAGE=
# Comma-separated vocabulary hints. Whisper will bias toward these spellings
# when it hears similar-sounding words. Keep short (under ~200 chars).
# Example: WHISPER_INITIAL_PROMPT=ecohubs, Mediakular, GreenfieldOS
WHISPER_INITIAL_PROMPT=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct

# Optional speaker diarization (pyannote, local + free). Off by default.
# To enable: accept the terms on huggingface.co for the diarization model
# (pyannote/speaker-diarization-community-1), create a read token at
# hf.co/settings/tokens, then set both below. Runs on-device, no per-meeting cost.
DIARIZATION_ENABLED=false
HF_TOKEN=
# DIARIZATION_MODEL=pyannote/speaker-diarization-community-1

DB_PATH=./data/transcripts.db
APP_PASSWORD=
