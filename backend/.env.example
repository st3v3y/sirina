# Transcription engine: auto (WhisperKit large-v3-turbo on Apple Silicon via the
# native speech helper — build it with native/speech-engine/build.sh), whisperkit,
# or faster-whisper (CPU fallback). Models download on first use.
TRANSCRIPTION_ENGINE=auto
# Defaults for new recordings (changeable per recording in the start dialog).
LIVE_TRANSCRIBE_DEFAULT=true
LIVE_CAPTIONS_DEFAULT=false
# CPU fallback (faster-whisper) model.
WHISPER_MODEL=medium
WHISPER_COMPUTE_TYPE=int8
# Force a language (e.g. en, es, de) to skip detection; empty = auto-detect.
WHISPER_LANGUAGE=
# Comma-separated vocabulary hints. Whisper will bias toward these spellings
# when it hears similar-sounding words. Keep short (under ~200 chars).
# Example: WHISPER_INITIAL_PROMPT=ecohubs, Mediakular, GreenfieldOS
WHISPER_INITIAL_PROMPT=

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b-instruct

# Optional speaker splitting (SpeakerKit, on-device, no account or token). Off by default.
DIARIZATION_ENABLED=false
# after_stop (default) or during_recording (also about every 10 min while recording).
DIARIZATION_TIMING=after_stop

DB_PATH=./data/transcripts.db
APP_PASSWORD=
